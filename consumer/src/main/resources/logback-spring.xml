<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Standard console appender for general application logs -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN:-%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Dedicated sync console appender for detection alerts -->
    <appender name="DETECTION_SYNC" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>[%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX, UTC}] %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Async non-blocking appender for high-throughput detection logging -->
    <appender name="DETECTION_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DETECTION_SYNC" />
        <queueSize>65536</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
    </appender>

    <!-- Dedicated logger for DetectionLogger with exact formatting -->
    <logger name="com.vinigodoy.detector.output.DetectionLogger" level="INFO" additivity="false">
        <appender-ref ref="DETECTION_ASYNC" />
    </logger>

    <!-- Mute noisy client libraries -->
    <logger name="io.awspring" level="WARN" />
    <logger name="software.amazon.awssdk" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="org.apache.http" level="WARN" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
